HARBOR_APP_ENV=development
HARBOR_HOST=127.0.0.1
HARBOR_PORT=8010
HARBOR_LOG_LEVEL=INFO
# CORS 使用 JSON 数组；开发期前端走 Vite 代理，通常无需修改
HARBOR_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# 模型提供方：deepseek（默认）或 dashscope（阿里云百炼 / 千问）。
# 切换千问时三个变量一起改：
#   HARBOR_MODEL_PROVIDER=dashscope
#   OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   OPENAI_MODEL=qwen-plus
# DashScope compatible-mode 同时提供 /embeddings（qwen3.7-text-embedding-flash），
# 语义召回才能真正生效；DeepSeek 端点没有 /embeddings，会降级成 keyword_2gram。
HARBOR_MODEL_PROVIDER=deepseek
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=
OPENAI_MODEL=deepseek-chat
OPENAI_EMBEDDING_MODEL=qwen3.7-text-embedding-flash
# 单次 /embeddings 请求的文本条数上限；flash 最多 20 条（text-embedding-v4 是 10）
OPENAI_EMBEDDING_BATCH_SIZE=20
