HARBOR_APP_ENV=development
HARBOR_HOST=127.0.0.1
HARBOR_PORT=8010
HARBOR_LOG_LEVEL=INFO
# CORS 使用 JSON 数组；开发期前端走 Vite 代理，通常无需修改
HARBOR_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# 模型提供方：deepseek（默认）或 dashscope（阿里云百炼 / 千问）。
# 切换千问时三个变量一起改：
#   HARBOR_MODEL_PROVIDER=dashscope
#   OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   OPENAI_MODEL=qwen-plus
# DashScope compatible-mode 同时提供 /embeddings（qwen3.7-text-embedding-flash），
# 语义召回才能真正生效；DeepSeek 端点没有 /embeddings，会降级成 keyword_2gram。
HARBOR_MODEL_PROVIDER=deepseek
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=
OPENAI_MODEL=deepseek-chat
OPENAI_EMBEDDING_MODEL=qwen3.7-text-embedding-flash
# 单次 /embeddings 请求的文本条数上限；flash 最多 20 条（text-embedding-v4 是 10）
OPENAI_EMBEDDING_BATCH_SIZE=20

# 会话持久化根目录（S6）：快照 + 流水都在这里。默认 <仓库>/data/sessions，
# 已被 .gitignore 覆盖。相对路径按启动时的 cwd 解析，通常不用改。
# HARBOR_SESSIONS_DIR=../data/sessions

# 上下文治理（S7）。阈值都是「占模型窗口的比例」：
#   STRATEGY       —— governed（默认，归档+校验+闸门）| legacy（回到 S7 前基线）
#   TRIGGER_RATIO  —— 到这里开始压缩；要早于闸门，给摘要调用本身留余量
#   GATE_RATIO     —— 硬闸门；压缩后仍超限则本轮直接 507，绝不发给模型
#   PROTECT_TURNS  —— 最近几轮用户消息（及其后全部消息）不参与压缩
#   ARCHIVE_DIR    —— 被压缩原文的归档目录；默认 <SESSIONS_DIR>/archives
HARBOR_CONTEXT_STRATEGY=governed
HARBOR_CONTEXT_TRIGGER_RATIO=0.6
HARBOR_CONTEXT_GATE_RATIO=0.85
HARBOR_CONTEXT_PROTECT_TURNS=2
# HARBOR_CONTEXT_ARCHIVE_DIR=../data/sessions/archives
